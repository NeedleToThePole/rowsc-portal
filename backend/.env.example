# =============================================
# ROWSC Portal Backend - Environment Variables
# =============================================
# Copy this to .env and fill in your values.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/rowsc_portal

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=8h

# Jotform Webhook Secret (from Jotform Integrations dashboard)
JOTFORM_WEBHOOK_SECRET=your_jotform_webhook_secret

# Admin CSV Migration Secret
ADMIN_SECRET=your_admin_migration_secret

# Email (SMTP via Gmail or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@rowsc.edu
SMTP_PASS=your_app_password_here
EMAIL_FROM_NAME=ROWSC Administration
EMAIL_FROM_ADDRESS=admin@rowsc.edu

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
